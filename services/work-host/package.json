{
  "name": "@slate/work-host",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host-sdk.d.ts",
      "import": "./dist/host-sdk.js"
    },
    "./gateway": {
      "types": "./dist/gateway-sdk.d.ts",
      "import": "./dist/gateway-sdk.js"
    },
    "./box-exec": {
      "types": "./dist/box-exec-sdk.d.ts",
      "import": "./dist/box-exec-sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "The Slate Work platform SDK for persistent agents, transcripts, runs, automations, workflows, rooms, channels and boxes.",
  "publishConfig": {
    "registry": "http://192.168.3.5:8081/repository/npm-hosted/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node ../../scripts/build-work-host.mjs",
    "test": "node --experimental-transform-types --no-warnings --test \"tests/**/*.test.ts\"",
    "rewrite:overlap": "node scripts/rewrite-overlap.mjs",
    "rewrite:check": "node scripts/rewrite-overlap.mjs check",
    "interop:check": "node scripts/check-interop-boundary.mjs",
    "interop:baseline": "node scripts/check-interop-boundary.mjs --write-baseline",
    "schema:generate": "cd source/adapters/interop/proto && buf generate",
    "redaction:generate": "node --experimental-transform-types --no-warnings scripts/generate-redacted-protos.mjs",
    "extension-ids:generate": "node scripts/generate-extension-ids.mjs",
    "extension-ids:check": "node scripts/generate-extension-ids.mjs check",
    "build": "node ../../scripts/build-work-host.mjs",
    "build:openlink": "node ../../scripts/build-work-host.mjs",
    "start:openlink": "node dist/host.mjs",
    "start": "node dist/host/main.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:openlink": "node scripts/smoke-openlink.mjs",
    "rewrite:triage": "node scripts/rewrite-triage.mjs",
    "smoke:openlink:bot": "node scripts/smoke-openlink-bot.mjs"
  },
  "dependencies": {
    "@slate/work-domain": "file:vendor/work-domain",
    "@slate/work-protocol": "file:vendor/work-protocol",
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-node": "^1.6.1",
    "@jimp/core": "^1.6.0",
    "@jimp/js-bmp": "^1.6.0",
    "@jimp/js-gif": "^1.6.0",
    "@jimp/js-jpeg": "^1.6.0",
    "@jimp/js-png": "^1.6.0",
    "@jimp/js-tiff": "^1.6.0",
    "@jimp/plugin-resize": "^1.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/otlp-exporter-base": "^0.222.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@streamparser/json": "^0.0.22",
    "ai": "^4.3.17",
    "diff": "^8.0.4",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.7.0",
    "image-type": "^4.1.0",
    "js-yaml": "^4.3.2",
    "jsonc-parser": "^3.3.1",
    "jschardet": "^3.1.4",
    "lru-cache": "^11.5.2",
    "mime-types": "^2.1.35",
    "minimatch": "^9.0.9",
    "piscina": "^4.9.4",
    "re2js": "^2.8.6",
    "rxjs": "^7.8.1",
    "tar": "^6.2.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.6.1",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^26.5.1",
    "@types/tar": "^6.1.13",
    "typescript": "7.0.2"
  }
}
