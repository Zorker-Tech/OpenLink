{
  "name": "@openlink/browser-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prebuild": "npm --prefix ../../packages/browser-protocol run build",
    "build": "tsc -p tsconfig.json",
    "check": "npm run prebuild && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:integration": "npm run build && node --test dist/test/preview-iframe.integration.js",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@openlink/browser-protocol": "file:../../packages/browser-protocol",
    "http-proxy": "1.18.1",
    "playwright-core": "1.64.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/http-proxy": "1.17.17",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
