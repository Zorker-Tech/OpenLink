FROM node:22-bookworm AS node-runtime

FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=0

RUN apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=600 -o Acquire::https::Timeout=600 -o Acquire::http::Proxy::deb.debian.org=DIRECT update \
  && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=600 -o Acquire::https::Timeout=600 -o Acquire::http::Proxy::deb.debian.org=DIRECT install -y --no-install-recommends \
       ca-certificates \
       chromium \
       fonts-noto-cjk \
       fonts-noto-color-emoji \
       git

# Node 24 crashes before startup in the Project VM's QEMU TCG. Keep the
# existing Chromium runtime layer and use the compatible Node 22 binary.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

WORKDIR /opt/openlink/browser-host

COPY packages/browser-protocol/package.json /opt/openlink/packages/browser-protocol/
COPY packages/browser-protocol/dist /opt/openlink/packages/browser-protocol/dist
COPY services/browser-host/package.json services/browser-host/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts=false \
  && rm -f node_modules/@openlink/browser-protocol \
  && ln -s /opt/openlink/packages/browser-protocol node_modules/@openlink/browser-protocol

COPY services/browser-host/dist ./dist

EXPOSE 43120
ENTRYPOINT ["node", "dist/src/main.js"]
