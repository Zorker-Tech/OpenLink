{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/openlink.mjs --mode development",
    "dev:web": "next dev --webpack",
    "dev:split": "node scripts/openlink.mjs --mode development --split-web",
    "dev:browser": "node scripts/openlink.mjs --mode development",
    "dev:local": "node scripts/openlink.mjs --mode development --profile local",
    "dev:cloud": "node --env-file=.env.cloud scripts/openlink.mjs --mode development --profile cloud",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "build": "next build",
    "build:web": "next build",
    "start": "node scripts/openlink.mjs --mode production",
    "start:cloud": "node --env-file=.env.cloud scripts/openlink.mjs --mode production --profile cloud",
    "start:web": "next start",
    "lint": "eslint .",
    "browser:build": "npm --prefix services/browser-host run build",
    "browser:test": "npm --prefix services/browser-host test",
    "agent:sync-pi": "node scripts/sync-pi-runtime.mjs",
    "agent:check-pi": "node scripts/sync-pi-runtime.mjs --check",
    "runtime:podman": "node scripts/ensure-podman-toolchain.mjs",
    "runtime:windows:prepare": "node scripts/ensure-podman-toolchain.mjs && node scripts/prepare-windows-host.mjs",
    "runtime:vm-image": "node scripts/run-with-env.mjs OPENLINK_BUILD_ARTIFACTS=1 -- node scripts/build-project-vm-base.mjs && node scripts/build-project-vm-disk.mjs",
    "runtime:project-supabase:sync": "node scripts/sync-project-supabase.mjs",
    "runtime:project-supabase:images": "node scripts/run-with-env.mjs OPENLINK_BUILD_ARTIFACTS=1 -- node scripts/build-project-supabase-images.mjs",
    "runtime:project-supabase:keygen": "node scripts/generate-project-supabase-release-key.mjs",
    "runtime:project-supabase:upgrade-bundle": "node scripts/build-project-supabase-upgrade.mjs",
    "runtime:project-supabase:validate-vm": "node scripts/validate-project-vm-supabase.mjs",
    "runtime:project-supabase:e2e": "node scripts/e2e-project-supabase.mjs",
    "runtime:project-supabase:test": "node --test scripts/test/project-supabase-lock.test.mjs scripts/test/sync-project-supabase.test.mjs scripts/test/project-supabase-images.test.mjs scripts/test/project-supabase-bundle.test.mjs scripts/test/project-vm-supabase-seed.test.mjs scripts/test/project-supabase-runtime.test.mjs",
    "runtime:images": "node scripts/build-project-runtime-images.mjs",
    "runtime:validate-linux-project-vm": "npm --prefix services/agent-host run build && node scripts/validate-remote-project-vm.mjs",
    "runtime:zokerbase": "node scripts/zokerbase.mjs start",
    "runtime:zokerbase:stop": "node scripts/zokerbase.mjs stop",
    "runtime:zokerbase:images": "node scripts/build-zokerbase-images.mjs",
    "runtime:zero": "node scripts/zero.mjs start",
    "runtime:zero:stop": "node scripts/zero.mjs stop",
    "runtime:zero:status": "node scripts/zero.mjs status",
    "runtime:zero:images": "node scripts/build-zero-images.mjs",
    "runtime:images:publish": "node scripts/publish-runtime-images.mjs",
    "release:build:self-hosted": "node scripts/build-self-hosted-release.mjs",
    "release:build:self-hosted-installer": "node scripts/build-self-hosted-installer.mjs",
    "release:test:self-hosted": "node --test --test-concurrency=1 scripts/test/self-hosted-release.test.mjs scripts/test/openlinkctl.test.mjs scripts/test/build-self-hosted-release.test.mjs scripts/test/self-hosted-deployment-profile.test.mjs scripts/test/self-hosted-virtualization.test.mjs scripts/test/self-hosted-runtime-selection.test.mjs scripts/test/self-hosted-preflight.test.mjs scripts/test/self-hosted-configuration.test.mjs scripts/test/self-hosted-runtime.test.mjs scripts/test/self-hosted-container-broker.test.mjs scripts/test/self-hosted-backup.test.mjs scripts/test/self-hosted-upgrade.test.mjs scripts/test/self-hosted-service-definitions.test.mjs scripts/test/self-hosted-installer-sea.test.mjs scripts/test/self-hosted-linux-identity-integration.test.mjs",
    "knowledge:check": "npm --prefix services/knowledge-service run check",
    "knowledge:test": "npm --prefix services/knowledge-service test",
    "platform-sdk:verify": "node scripts/verify-platform-sdk-install.mjs",
    "storybook:inventory": "node scripts/generate-storybook-inventory.mjs",
    "storybook": "pnpm storybook:inventory && storybook dev -p 6006 --no-open",
    "storybook:build": "pnpm storybook:inventory && storybook build",
    "storybook:test": "pnpm storybook:inventory && vitest run --project=storybook",
    "build-storybook": "pnpm storybook:inventory && storybook build"
  },
