{
  "name": "@slate/work-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Work platform: persistent agents, transcripts, runs, automation, workflow, rooms, channels and boxes. Ships with the desktop app; independent of the Code agent.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings --test \"tests/**/*.test.ts\"",
    "schema:generate": "cd source/packages/proto && buf generate",
    "redaction:generate": "node --experimental-transform-types --no-warnings scripts/generate-redacted-protos.mjs",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-node": "^1.6.1",
    "@jimp/core": "^1.6.0",
    "@jimp/js-bmp": "^1.6.0",
    "@jimp/js-gif": "^1.6.0",
    "@jimp/js-jpeg": "^1.6.0",
    "@jimp/js-png": "^1.6.0",
    "@jimp/js-tiff": "^1.6.0",
    "@jimp/plugin-resize": "^1.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@slate/work-protocol": "workspace:*",
    "@streamparser/json": "^0.0.22",
    "ai": "^4.3.17",
    "diff": "^8.0.4",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.7.0",
    "image-type": "^4.1.0",
    "js-yaml": "^4.3.2",
    "jschardet": "^3.1.4",
    "lru-cache": "^11.5.2",
    "mime-types": "^2.1.35",
    "minimatch": "^9.0.9",
    "piscina": "^4.9.4",
    "re2js": "^2.8.6",
    "rxjs": "^7.8.1",
    "tar": "^6.2.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^26.5.1",
    "@types/tar": "^6.1.13",
    "typescript": "catalog:"
  }
}
