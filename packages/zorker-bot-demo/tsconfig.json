{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "incremental": false,
    "allowImportingTsExtensions": false,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src"]
}
