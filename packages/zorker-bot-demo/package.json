{
  "name": "@zorker/bot-demo",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./website": {
      "types": "./dist/website/index.d.ts",
      "import": "./dist/website/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./styles.css": "./dist/styles/zorker-bot-demo.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "npm --prefix ../avatar run build && tsc -p tsconfig.json && node scripts/copy-static.mjs"
  },
  "dependencies": {
    "@zorker/avatar": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
